+	inout logic [31:0] dq
 );
+	logic choose,hight;
+	// always_ff@(posedge clk)if(cke && Enum'({ras,cas,we}) == Activ)hight <= ba[2];
+	// assign choose = (Enum'({ras,cas,we}) == Activ)?ba[2]:hight;
+	sdramCore #(.Index(2'b0),.Hight(1'b0)) sdramCore0 (
+		.clk(clk),
+		.cke(cke),
+		.cs(cs|ba[2]),
+		.ras(ras),
+		.cas(cas),
