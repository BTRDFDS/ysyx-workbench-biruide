+logic [4:0] addr;
+logic [15:0]led;
+logic [3:0]seg[7:0];
+always_ff @(posedge clock) begin
+	if(reset) addr <='0;
+	else if(in_psel && ~in_penable)addr<=in_paddr[4:0];
